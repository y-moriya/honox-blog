# =============================================================
# Cloudflare Pages _headers
# https://developers.cloudflare.com/pages/configuration/headers/
# =============================================================

# 全ページ共通のセキュリティヘッダー
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://0.gravatar.com; font-src 'self' https://fonts.gstatic.com; frame-src https://gravatar.com; connect-src 'self' https://www.google-analytics.com;
  Cache-Control: no-cache

# 静的アセット（JS/CSS/フォント/画像）: 長期キャッシュ
/static/*
  Cache-Control: public, max-age=31536000, immutable
